# StarCoPlay Agent 环境配置
# 复制此文件为 .env 并填入你的实际值：cp .env.example .env

# ── LLM 配置 ─────────────────────────────────────────────────────────
# Provider: anthropic / openai（对应 aisuite 的 provider 前缀）
LLM_PROVIDER=anthropic

# 模型名（不含 provider 前缀，启动时自动拼接为 provider:model）
LLM_MODEL=claude-sonnet-4-20250514

# API Key（根据 provider 填写对应的 key）
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1  # 可选：自定义 API 地址（兼容中转站）

# ── Bridge 配置 ───────────────────────────────────────────────────────
# Mod 文件桥路径（留空则自动按平台探测 Mods/StarCoPlay/bridge/）
# BRIDGE_PATH=/path/to/StardewValley/Mods/StarCoPlay/bridge

# ── 游戏启动配置 ─────────────────────────────────────────────────────
# 游戏安装目录（留空则自动按平台探测 Steam 安装路径）
# GAME_PATH=/path/to/StardewValley

# Agent 启动时是否自动拉起第二个游戏实例（true/false，默认 false）
AUTO_LAUNCH_GAME=false

# ── 统一配置服务 ──────────────────────────────────────────────────────
# Backend 内部配置 API 地址（指向 platform backend，不是 Web）
STARCOPLAY_BACKEND_URL=http://127.0.0.1:8766

# 统一业务配置环境（dev / test / prod，留空默认 prod）
STARCOPLAY_CONFIG_ENV=prod

# Backend internal API token（与 ECS /etc/star-coplay.env 中 INTERNAL_API_TOKEN 一致）
INTERNAL_API_TOKEN=
