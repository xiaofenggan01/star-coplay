# StarCoplay Agent 配置
# 复制为 .env 并填写实际值: cp .env.example .env

# ── LLM 配置（必填）──
API_KEY=sk-your-api-key-here
BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.5-highspeed
# LLM_PROVIDER=openai_compatible  # 默认值，通常无需修改

# ── Bridge 目录（连接游戏时必填，干运行模式可不填）──
# macOS 路径（请将 <用户名> 替换为实际用户名，路径含空格必须加引号）:
# STARDEW_BRIDGE_DIR="/Users/<用户名>/Library/Application Support/Steam/steamapps/common/Stardew Valley/Contents/MacOS/Mods/StarCoPlay/bridge"
# Windows 路径示例:
# STARDEW_BRIDGE_DIR="D:\SteamLibrary\steamapps\common\Stardew Valley\Mods\StarCoPlay\bridge"

# ── 可选配置 ──
# STARDEW_AGENT_POLL=0.15           # 轮询间隔（秒）
# STARDEW_AGENT_RESULT_TIMEOUT=4.0  # 命令结果等待超时（秒）
# STARDEW_AGENT_MEMORY_LIMIT=100    # 短期记忆容量
# STARDEW_AGENT_RECENT_LIMIT=10     # 工作记忆容量
# STARCoplay_AGENT_DRY_RUN=1        # 干运行模式（无需游戏）
# EVOMAP_ENABLED=false              # EvoMap 社区规则共享
