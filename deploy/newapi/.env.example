# Star Coplay NewAPI Docker parameters.
#
# Copy this file to .env before running docker compose.
# The values below are generated random samples for first deployment rehearsal.
# Because this file is committed, rotate the secrets in the server-only .env
# before treating the deployment as long-term production.

NEWAPI_HOST_PORT=13000
NEWAPI_POSTGRES_USER=newapi
NEWAPI_POSTGRES_PASSWORD=change-me
NEWAPI_POSTGRES_DB=new-api
NEWAPI_REDIS_PASSWORD=change-me
NEWAPI_SESSION_SECRET=change-me
NEWAPI_NODE_NAME=star-coplay-newapi-prod
NEWAPI_ERROR_LOG_ENABLED=true
NEWAPI_BATCH_UPDATE_ENABLED=true
NEWAPI_STREAMING_TIMEOUT=300
# NewAPI only binds to 127.0.0.1 in this deployment. Bulk user migration calls
# internal admin/search/login APIs quickly, so keep these disabled unless NewAPI
# is intentionally exposed through another trusted gateway.
NEWAPI_GLOBAL_API_RATE_LIMIT_ENABLE=false
NEWAPI_CRITICAL_RATE_LIMIT_ENABLE=false
NEWAPI_SEARCH_RATE_LIMIT_ENABLE=false

# Star Coplay backend integration.
# Fill NEWAPI_ADMIN_ACCESS_TOKEN after logging into NewAPI admin UI and creating
# an access token for the root/admin user.
NEWAPI_ADMIN_ACCESS_TOKEN=
NEWAPI_ADMIN_USER_ID=1
INTERNAL_API_TOKEN=your-internal-api-token
AI_RELAY_AGENT_MODEL_TIER=balanced
NEWAPI_ROOT_USERNAME=root
NEWAPI_ROOT_PASSWORD=change-me
