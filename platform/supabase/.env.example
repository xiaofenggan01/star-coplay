# 自托管/本地（SUPABASE_URL 非 *.supabase.co）时 register 会自动追加 dev-local
#
# Next 前端公网变量见同仓 ../web/.env.example（复制为 web/.env.local）；Edge/DB 密钥只在本文与本目录 .env。
#
# Edge 变量：推荐 platform 目录 npm run fn:serve；手敲 npx 须带 --env-file supabase/.env 或配置 functions/.env
# 非 *.supabase.co 时 register 会合并上方 INVITE_CODES 与内建 beta-2026/test-invite/dev-local
#
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>
INVITE_CODES=<your-invite-codes>
ADMIN_SECRET=<your-admin-secret>
STARCOPLAY_CONFIG_ENV=prod
INTERNAL_API_TOKEN=your-internal-api-token
