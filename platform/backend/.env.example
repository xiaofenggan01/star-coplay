# === Database ===
DATABASE_URL=postgresql://user:pass@localhost:54322/postgres
REDIS_URL=redis://localhost:6379

# === Supabase ===
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === WebSocket Gateway ===
WS_GATEWAY_HOST=0.0.0.0
WS_GATEWAY_PORT=8765
WS_GATEWAY_PATH=/ws

# === HTTP API ===
WS_HTTP_HOST=0.0.0.0
WS_HTTP_PORT=8766
WS_HTTP_ALLOW_ORIGIN=*

# === NewAPI Relay ===
NEWAPI_BASE_URL=http://127.0.0.1:13000
NEWAPI_ADMIN_ACCESS_TOKEN=your-newapi-admin-access-token
NEWAPI_ADMIN_USER_ID=1

# === Agent ===
STARCOPLAY_PLATFORM_URL=http://127.0.0.1:3000
STARCOPLAY_CONFIG_ENV=prod
INTERNAL_API_TOKEN=your-internal-api-token

# === Admin ===
ADMIN_SECRET=your-admin-secret

# === Logging ===
LOG_LEVEL=INFO

# === Auth Bypass (dev only) ===
# STARCOPLAY_WS_AUTH_BYPASS=1
# STARCOPLAY_WS_AUTH_BYPASS_USER_ID=00000000-0000-0000-0000-000000000001

# === Hosted Runtime ===
# Keep disabled until the complete Hosted profile below is configured.
STARCOPLAY_RUNTIME_MANAGER_ENABLED=0
# HOSTED_GAME_SESSION_ROUTE_ENABLED=1
# STARCOPLAY_RUNTIME_MANAGER_WORKSPACE_ROOT=/var/lib/starcoplay/runtimes
# STARCOPLAY_CLAUDE_BINARY=/usr/bin/node
# STARCOPLAY_CLAUDE_CLI_PATH=/opt/claude-code/cli.js
# STARCOPLAY_RUNTIME_CONTROL_CLAIMS_SECRET=<at-least-32-characters>
# STARCOPLAY_RUNTIME_CONTROL_SERVICES_JSON={"platform":{"all_tenants":true}}
# STARCOPLAY_RUNTIME_LLM_RELAY_SECRET=<different-at-least-32-character-secret>
# STARCOPLAY_RUNTIME_LLM_RELAY_BASE_URL=http://127.0.0.1:8766/internal/runtime-llm
# GA: every authenticated platform tenant is admitted.
# STARCOPLAY_HOSTED_RUNTIME_ADMISSION_MODE=all_authenticated
# Staged rollout: provide one or more exact user UUIDs.
# STARCOPLAY_HOSTED_RUNTIME_ADMISSION_MODE=allowlist
# STARCOPLAY_CC_ALLOWLIST=<user-uuid-a>,<user-uuid-b>
