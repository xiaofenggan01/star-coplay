<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableHarmony>true</EnableHarmony>
    <BundleExtraAssemblies>ThirdParty</BundleExtraAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StarCoPlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="i18n\default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="i18n\zh.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="i18n\zh-CN.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\protocol\fixtures\phase1\*.json"
          Link="Protocol\Fixtures\phase1\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.deprecated.cs" />
    <None Include="**\*.deprecated.cs" />
  </ItemGroup>

</Project>
